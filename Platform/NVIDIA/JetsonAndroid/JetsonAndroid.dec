[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = JetsonAndroidPkg
  PACKAGE_GUID                   = d154828a-4298-413b-aa8d-7d7bae0757d6
  PACKAGE_VERSION                = 0.1

[PcdsFixedAtBuild.common]
# Tegra Scratch0 Register Addresses
  gNVIDIATokenSpaceGuid.PcdScratch0RegisterBaseAddressT194|0x0C392000|UINT64|0x00009900
  gNVIDIATokenSpaceGuid.PcdScratch0RegisterBaseAddressT234|0x0C392000|UINT64|0x00009901

#Force Boot to Recovery
  gNVIDIATokenSpaceGuid.PcdBootToRecovery|FALSE|BOOLEAN|0x00009902

#Decrement RootfsRetrySlot<A|B> and switch boot chains in the launcher (needs an EFI boot HAL)
  gNVIDIATokenSpaceGuid.PcdRootfsRetryValidation|TRUE|BOOLEAN|0x00009903
